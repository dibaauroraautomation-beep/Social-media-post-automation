# Copy this file to .env.local (same folder as package.json) and fill in real values.
# All of these are NEXT_PUBLIC_ because page.tsx calls Supabase and n8n directly
# from the browser (per your setup) — do not put secrets you can't expose in here.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Your n8n webhook URLs (Production URL of each webhook node, with CORS
# allowed for your dashboard's origin — n8n webhook nodes need
# "Allowed Origins (CORS)" set, or the "Respond to Webhook" node needs
# an Access-Control-Allow-Origin header, or the browser fetch will fail)

# Generate Content — both fire together when the button is clicked
NEXT_PUBLIC_N8N_GENERATE_CONTENT_MORNING_WEBHOOK=https://n8naurora.duckdns.org/webhook/post-creator-morning
NEXT_PUBLIC_N8N_GENERATE_CONTENT_EVENING_WEBHOOK=https://n8naurora.duckdns.org/webhook/post-creator-evening

# Improve (modal) — routed by the post's time: exactly 6:30 = morning, else evening
NEXT_PUBLIC_N8N_IMPROVE_MORNING_WEBHOOK=https://n8naurora.duckdns.org/webhook/edit-flow-morning
NEXT_PUBLIC_N8N_IMPROVE_EVENING_WEBHOOK=https://n8naurora.duckdns.org/webhook/edit-flow-evening

# Approve (card) — routed by the post's time
NEXT_PUBLIC_N8N_APPROVE_MORNING_WEBHOOK=https://n8naurora.duckdns.org/webhook/approve-post-morning
NEXT_PUBLIC_N8N_APPROVE_EVENING_WEBHOOK=https://n8naurora.duckdns.org/webhook/approve-post-evening

# Post Now (card) — routed by the post's time
NEXT_PUBLIC_N8N_POST_NOW_MORNING_WEBHOOK=https://n8naurora.duckdns.org/webhook/post-now-morning
NEXT_PUBLIC_N8N_POST_NOW_EVENING_WEBHOOK=https://n8naurora.duckdns.org/webhook/post-now-evening

NEXT_PUBLIC_N8N_TRANSLATE_WEBHOOK=https://your-n8n.example.com/webhook/translate-caption
NEXT_PUBLIC_N8N_FEEDBACK_WEBHOOK=https://your-n8n.example.com/webhook/feedback-aurora
